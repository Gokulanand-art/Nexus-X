# Nexus v2 configuration — copy to .env and edit.

# ── Models (Ollama, offline) ─────────────────────────────────────────────
NEXUS_CHAT_MODEL=qwen2.5-coder:1.5b
NEXUS_EMBED_MODEL=nomic-embed-text
NEXUS_EMBED_DIM=768

# ── Context / speed ──────────────────────────────────────────────────────
NEXUS_NUM_CTX=16384
NEXUS_CONTEXT_BUDGET=8192
NEXUS_MAX_GENERATION=1536
NEXUS_THINK_BUDGET=384
NEXUS_TEMPERATURE=0.2
NEXUS_THINKING=auto        # on | off | auto

# ── RAG ──────────────────────────────────────────────────────────────────
NEXUS_RAG_TOP_K=8
NEXUS_RAG_MIN_SCORE=0.35
NEXUS_CHUNK_TOKENS=400
NEXUS_CHUNK_OVERLAP=60

# ── Supabase (optional — omit to use the local SQLite store) ──────────────
# Project URL like https://abcd1234.supabase.co
# SUPABASE_URL=
# Service-role key from Project Settings → API
# SUPABASE_SERVICE_KEY=
